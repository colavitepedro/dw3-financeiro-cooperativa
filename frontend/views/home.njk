{% extends "layout.njk" %}
{% block content %}
<div class="app-shell" data-api-url="{{ apiUrl }}">
   {% include "partials/header.njk" %}
   <main class="page-content" id="dashboardPage">
         <div class="page-heading">
            <div>
               <h1>Visão geral</h1>
               <p class="muted">Resumo das contas e categorias cadastradas.</p>
            </div>
            <a class="button button-primary" href="/contas-pagar">Nova conta</a>
         </div>
         <div id="pageMessage" class="notice" role="status" hidden></div>
         <section class="summary-grid" aria-label="Resumo financeiro">
            <article class="summary-card">
               <span>Contas ativas</span>
               <strong id="summaryTotal">—</strong>
               <small>Registros cadastrados</small>
            </article>
            <article class="summary-card">
               <span>Valor total</span>
               <strong id="summaryAmount">—</strong>
               <small>Soma das contas ativas</small>
            </article>
            <article class="summary-card">
               <span>Vencem em 7 dias</span>
               <strong id="summaryDue">—</strong>
               <small>Contas a partir de hoje</small>
            </article>
            <article class="summary-card">
               <span>Categorias ativas</span>
               <strong id="summaryPlans">—</strong>
               <small>Itens do plano de contas</small>
            </article>
         </section>
         <section class="content-card">
            <div class="card-heading">
               <div>
                  <h2>Próximos vencimentos</h2>
                  <p class="muted">Contas com vencimento nos próximos 7 dias.</p>
               </div>
               <a class="text-link" href="/contas-pagar">Ver todas</a>
            </div>
            <div class="table-wrap">
               <table>
                  <thead>
                     <tr>
                        <th>Descrição</th>
                        <th>Fornecedor</th>
                        <th>Categoria</th>
                        <th>Vencimento</th>
                        <th class="align-right">Valor</th>
                     </tr>
                  </thead>
                  <tbody id="upcomingRows">
                     <tr><td colspan="5" class="table-state">Buscando contas com vencimento próximo…</td></tr>
                  </tbody>
               </table>
            </div>
         </section>
   </main>
</div>
<script src="/js/api.js"></script>
<script src="/js/layout.js"></script>
<script src="/js/vencimentos.js"></script>
<script src="/js/home.js"></script>
{% endblock %}
