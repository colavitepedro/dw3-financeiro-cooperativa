# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dw3_financeiro
DB_USER=seu-usuario-do-postgres
DB_PASSWORD=senha-local-do-postgres

# Segredo aleatório com pelo menos 32 caracteres
JWT_SECRET=defina-um-segredo-aleatorio-com-32-caracteres-ou-mais
JWT_EXPIRES_IN=2h

# Portas dos servidores (front-end e back-end separados)
API_PORT=40000
WEB_PORT=40100
API_URL=http://localhost:40000
WEB_ORIGIN=http://localhost:40100

# Usados somente pelo comando npm run seed:admin
ADMIN_USERNAME=escolha-um-usuario
ADMIN_PASSWORD=escolha-uma-senha-com-8-caracteres-ou-mais
